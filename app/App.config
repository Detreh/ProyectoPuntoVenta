<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<connectionStrings>

		<add name="PuntoVenta"
             connectionString="Server=localhost;Port=3306;Database=punto_venta;User ID=admin_pv;Password=PASSWORD;"
             providerName="MySqlConnector" />

	</connectionStrings>
	<appSettings>
        <add key="ServidorBD" value="localhost"/>
        <add key="PuertoBD" value="3306"/>
        <add key="BaseDatos" value="punto_venta"/>
    </appSettings>

</configuration>